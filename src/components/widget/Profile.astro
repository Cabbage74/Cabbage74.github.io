---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";
import { url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;
const links = config.links;
const qrLinks = links.filter(l => l.qr);
---
<div class="card-base p-3">
    <a aria-label="Go to About Page" href={url('/about/')}
       class="group block relative mx-auto mt-1 lg:mx-0 lg:mt-0 mb-3
       max-w-[12rem] lg:max-w-none overflow-hidden rounded-xl active:scale-95">
        <div class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center">
            <Icon name="fa6-regular:address-card"
                  class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl">
            </Icon>
        </div>
        <ImageWrapper src={config.avatar || ""} alt="Profile Image of the Author" class="mx-auto lg:w-full h-full lg:mt-0 "></ImageWrapper>
    </a>
    <div class="px-2">
        <div class="font-bold text-xl text-center mb-1 dark:text-neutral-50 transition">{config.name}</div>
        <div class="h-1 w-5 bg-[var(--primary)] mx-auto rounded-full mb-2 transition"></div>
        <div class="text-center text-neutral-400 mb-2.5 transition">{config.bio}</div>
        <div class="flex flex-wrap gap-2 justify-center mb-1">
            {links.map(item => {
                if (item.qr) {
                    const modalId = `qr-modal-${item.name.toLowerCase().replace(/\s+/g, '-')}`;
                    return (
                        <button type="button" aria-label={item.name} data-qr-modal={modalId}
                                class="qr-trigger btn-regular rounded-lg h-10 w-10 active:scale-90">
                            <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                        </button>
                    );
                }
                if (links.length > 1) {
                    return (
                        <a rel="me" aria-label={item.name} href={item.url} target="_blank" class="btn-regular rounded-lg h-10 w-10 active:scale-90">
                            <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                        </a>
                    );
                }
                return (
                    <a rel="me" aria-label={item.name} href={item.url} target="_blank"
                       class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95">
                        <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                        {item.name}
                    </a>
                );
            })}
        </div>
    </div>
</div>

{qrLinks.map(item => {
    const modalId = `qr-modal-${item.name.toLowerCase().replace(/\s+/g, '-')}`;
    return (
        <div id={modalId} class="qr-modal fixed inset-0 z-[999] flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-200">
            <div class="qr-backdrop absolute inset-0 bg-black/60"></div>
            <div class="relative bg-[var(--card-bg)] rounded-xl p-6 mx-4 max-w-xs w-full shadow-2xl">
                <button type="button" class="qr-close absolute top-2 right-2 btn-regular rounded-lg h-8 w-8 active:scale-90">
                    <Icon name="fa6-solid:xmark" class="text-lg"></Icon>
                </button>
                <div class="text-center font-bold text-lg mb-3">{item.name}</div>
                <img src={url(item.qr!)} alt={`${item.name} QR Code`} class="w-full rounded-lg" />
                <div class="text-center text-sm text-neutral-400 mt-2">Scan to add me on {item.name}</div>
            </div>
        </div>
    );
})}

<script>
    document.querySelectorAll('.qr-trigger').forEach(btn => {
        btn.addEventListener('click', () => {
            const modalId = (btn as HTMLElement).dataset.qrModal;
            const modal = document.getElementById(modalId!);
            if (modal) {
                modal.classList.remove('opacity-0', 'pointer-events-none');
            }
        });
    });
    document.querySelectorAll('.qr-modal').forEach(modal => {
        modal.querySelector('.qr-backdrop')?.addEventListener('click', () => {
            modal.classList.add('opacity-0', 'pointer-events-none');
        });
        modal.querySelector('.qr-close')?.addEventListener('click', () => {
            modal.classList.add('opacity-0', 'pointer-events-none');
        });
    });
</script>


---
import { getCollection } from "astro:content";

// Only render secret articles during the local encrypt step.
// Plaintext must never be emitted into dist/ by a normal build (e.g. CI).
export async function getStaticPaths() {
	if (!process.env.SECRET_PASSWORD) return [];
	const secrets = await getCollection("secrets");
	return secrets.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const d = entry.data.published;
const published = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
---

<!DOCTYPE html>
<html lang="zh">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{entry.data.title}</title>
	</head>
	<body>
		<div id="secret-article" data-pagefind-ignore>
			<h1 class="secret-title">{entry.data.title}</h1>
			<div class="secret-published">{published}</div>
			<div class="prose dark:prose-invert prose-base !max-w-none custom-md markdown-content">
				<Content />
			</div>
		</div>
	</body>
</html>
